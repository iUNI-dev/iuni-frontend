{
  "expo": {
    "name": "iuni-expo",
    "slug": "iuni-expo",
    "scheme": "iuniexpo",
    "android": {
      "package": "com.anonymous.iuniexpo",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "iuniexpo",
              "host": "oauth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }

,
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e03daa5-8c60-4078-b11d-a5b6e4deac0d"
      }
    }
  }
